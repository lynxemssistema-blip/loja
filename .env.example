# =========================================================
# PARCEIRO LYNX - CONFIGURAÇÃO DE AMBIENTE (SUPABASE VPS + ASAAS)
# =========================================================

# 1. SUPABASE NA SUA VPS (Quando tiver os dados, preencha no .env.local ou na tela de Configurações)
NEXT_PUBLIC_SUPABASE_URL=https://seu-supabase.suavps.com.br
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# 2. INTEGRAÇÃO ASAAS (Pode ser configurado aqui ou direto pelo painel SuperAdmin)
ASAAS_API_URL=https://api.asaas.com/v3
ASAAS_API_KEY=$aact_sua_chave_asaas_aqui

# 3. SUPERADMIN PADRÃO E URL OFICIAL
SUPERADMIN_EMAIL=edsonmanoel2012@gmail.com
NEXT_PUBLIC_APP_URL=https://loja.lynxems.com.br

