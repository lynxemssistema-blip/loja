# ========================================================
# Hostinger LiteSpeed / Apache Reverse Proxy para Next.js
# Domínio: loja.lynxems.com.br -> Node.js (127.0.0.1:31501)
# ========================================================

RewriteEngine On

# Manter cabeçalhos do Proxy
RequestHeader set X-Forwarded-Proto "https"
RequestHeader set X-Forwarded-Port "443"

# Redirecionamento para a porta interna 31501 do Node.js
RewriteRule ^$ http://127.0.0.1:31501/ [P,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ http://127.0.0.1:31501/$1 [P,L]
